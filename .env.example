# Токен от @BotFather
BOT_TOKEN=
# Числовой Telegram ID владельца. Обязателен на новом ПК; прежний ID из базы сохраняется.
OWNER_ID=

# Город как в адресе Авито: avito.ru/<город>/...
CITY=kazan
# Лента — раздел Авито, одна на город («Электроника»: в ней и комплектующие, и ПК).
# Из неё берутся только объявления нужных разделов (по адресу объявления).
FEED=bytovaya_elektronika
SECTIONS=tovary_dlya_kompyutera,nastolnye_kompyutery

# Сколько раз в минуту загружать ленту. Это общий лимит на компьютер: города запросов
# проверяются по очереди. Около 12 в минуту Авито блокирует; после каждой блокировки
# опрос останавливается; лимит не гарантирует отсутствие капчи. Ночью — отдельный лимит.
REQUESTS_PER_MINUTE=1
NIGHT_REQUESTS_PER_MINUTE=1
NIGHT_HOURS=2-7

# Только если на компьютере включён VPN (Clash, Happ, Hiddify и т.п.): трафик к Авито
# пойдёт напрямую через домашнюю сеть. Без VPN оставьте пустым.
#   macOS:         имя интерфейса, обычно en0 (Wi-Fi)
#   Windows/Linux: локальный IP компьютера в домашней сети, например 192.168.1.5
DIRECT_INTERFACE=
# 1 — без окна браузера (Авито такой режим обычно блокирует)
HEADLESS=0

# Минимальная пауза после HTTP 429, в секундах. Retry-After может её увеличить.
COOLDOWN_SECONDS=900
# Только безопасный образец структуры HTML, без скриптов, форм и cookies.
SAVE_DEBUG_HTML=0
DEBUG_HTML_RETENTION_HOURS=24

# Экспериментальный движок устанавливается отдельно: uv sync --frozen --extra experimental
# Переключайте только после остановки приложения. Ограничения и seen остаются общими.
BROWSER_ENGINE=playwright
# light_fetch: первая навигация, затем fetch HTML; page_navigation: навигация каждый раз.
FETCH_MODE=light_fetch
# Установленный Google Chrome; chromium выбирается явно, автоматического fallback нет.
BROWSER_CHANNEL=chrome
