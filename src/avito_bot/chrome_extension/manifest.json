{
  "manifest_version": 3,
  "name": "Avito Monitor — текущий Chrome",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Локальное подключение Avito Monitor к одной выделенной вкладке в вашем Chrome.",
  "permissions": ["scripting", "storage", "alarms", "webRequest", "webNavigation"],
  "host_permissions": ["https://www.avito.ru/*", "https://avito.ru/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Подключить Avito Monitor", "default_popup": "popup.html"}
}
